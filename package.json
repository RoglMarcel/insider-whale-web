{
  "name": "insider-whale-terminal",
  "version": "1.1.2",
  "description": "Insider & Whale Stock Signal Tracker — desktop app that scrapes insider trading and unusual options flow, scores conviction, and ranks tickers.",
  "author": "Insider Tracker",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "scrape:web": "esbuild scripts/scrape-web.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:playwright --alias:electron=./scripts/electron-stub.ts --outfile=tmp/scrape-web.cjs && node tmp/scrape-web.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "rebuild": "electron-builder install-app-deps",
    "verify:scoring": "esbuild scripts/verify-scoring.ts --bundle --platform=node --format=cjs --outfile=tmp/verify-scoring.cjs && node tmp/verify-scoring.cjs",
    "verify:db": "esbuild scripts/verify-db.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=tmp/verify-db.cjs && electron tmp/verify-db.cjs",
    "verify:scrape": "esbuild scripts/verify-scrape.ts --bundle --platform=node --format=cjs --external:playwright --external:better-sqlite3 --outfile=tmp/verify-scrape.cjs && node tmp/verify-scrape.cjs",
    "backtest": "esbuild scripts/backtest.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --outfile=tmp/backtest.cjs && electron tmp/backtest.cjs",
    "backtest:components": "esbuild scripts/backtest-components.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=tmp/backtest-components.cjs && electron tmp/backtest-components.cjs",
    "backtest:opportunistic": "esbuild scripts/backtest-opportunistic.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=tmp/backtest-opportunistic.cjs && electron tmp/backtest-opportunistic.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.9.3",
    "node-cron": "^3.0.3",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "zustand": "^4.5.4"
  }
}
